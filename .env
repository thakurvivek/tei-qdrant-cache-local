# .env
# Configuration for Embedding Cache Proxy

# --- Model Configuration ---
EMBEDDING_DIMENSION=1024        # !!! SET THIS TO YOUR MODEL'S OUTPUT DIMENSION !!!

# --- Deployment Configuration ---
HOST_PORT=8081 # Port for the CACHE PROXY service

# --- Embedding Engine Configuration ---
# Options: sglang, vllm, tei, openai, custom
EMBEDDING_ENGINE=sglang
# URL for embedding service (without /embed or /v1/embeddings path)
EMBEDDING_ENGINE_URL=http://buddha.alpine-musical.ts.net:5000/v1/embeddings
# Whether to append /embed to URL (TEI needs it, sglang/vllm don't)
APPEND_EMBED_PATH=false
# URL for the actual embedding service (used by cache proxy to forward requests)
NGINX_UPSTREAM_URL=http://buddha.alpine-musical.ts.net:5000/v1/embeddings

# --- Qdrant Cache Configuration ---
QDRANT_COLLECTION=text_embedding_cache_octen-0.6b-fp16
QDRANT_HOST=buddha.alpine-musical.ts.net # Latest Qdrant instance
QDRANT_PORT=6336   # Latest Qdrant instance gRPC port

# --- Cache Proxy Configuration ---
CACHE_HASH_FUNCTION=sha256 # Or md5 (faster but higher collision risk)
TEI_REQUEST_BATCH_SIZE=12

# --- Retry Configuration ---
MAX_RETRIES=3
RETRY_DELAY_BASE=1.0
RETRY_DELAY_MAX=10.0
BATCH_DELAY_SECONDS=0.5
